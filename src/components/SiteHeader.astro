---
/**
 * Nav is four items and that is the ceiling; anything further goes in the
 * footer. A search affordance is required rather than optional: the search
 * button grows into a field in the masthead itself, the section links making
 * way for it, and the results drop below it.
 *
 * Not sticky — see components.css for why. Routes come from the one registry,
 * which renders only what exists so nothing in the chrome ever 404s.
 */
import { primaryRoutes } from '../data/routes.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { current } = Astro.props as { current?: string };
const links = primaryRoutes();

/** What each first path segment holds, for the label beside a search result. */
const kinds = {
  drinks: 'Drink',
  ingredients: 'Ingredient',
  preparations: 'Preparation',
  techniques: 'Technique',
  methods: 'Method',
  categories: 'Category',
  origins: 'Origin',
  spirits: 'Spirit',
  families: 'Family',
  glassware: 'Glass',
};
---

<header class="masthead" data-pagefind-ignore>
  <div class="wrap">
    <div class="masthead-inner glass glass--refract">
      {/* The same file the tab shows. An `<img>` rather than an inline copy so
          the two cannot drift apart, and so the glass stays a hole — on the
          masthead that hole shows the frosted surface behind it. */}
      <a class="logo" href={`${base}/`} data-hs-logo>
        <img class="logo-mark" src={`${base}/favicon.svg`} alt="" width="26" height="26" />
        <span>e<b>X</b>ir</span>
      </a>

      <nav class="nav" aria-label="Main" data-hs-fade>
        {links.map((l) => (
          <a
            href={`${base}${l.path}`}
            {...(current && l.path.includes(current) ? { 'aria-current': 'page' } : {})}
          >
            <span class="nav-label">{l.label}</span>
            {l.count && <span class="nav-count" data-bar-count aria-hidden="true"></span>}
          </a>
        ))}
      </nav>

      {/*
        The controls, always in this order: search, then this site's own (the
        glass material), theme, about. Round icon buttons of one size, so the
        group reads as one thing at the end of the row.
      */}
      <div class="controls">
        <div class="hs" data-hs data-hs-base={base} data-hs-kinds={JSON.stringify(kinds)}>
          <div class="hs-field" data-hs-field>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
            </svg>
            <input type="search" placeholder="Search drinks, ingredients, techniques" aria-label="Search eXir" autocomplete="off" />
            <button class="hs-close" type="button" data-hs-close aria-label="Close search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M7 7l10 10M17 7 7 17" stroke-linecap="round"></path>
              </svg>
            </button>
          </div>
          <button
            class="icon-btn"
            type="button"
            data-hs-button
            aria-expanded="false"
            aria-controls="site-search"
            aria-label="Search"
            title="Search (press /)"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>
            </svg>
          </button>
          <div class="hs-panel" id="site-search" data-hs-panel>
            <div class="hs-results" data-hs-results aria-live="polite">
              <p class="hs-status">Every drink, ingredient and technique, by any of the names it goes by.</p>
            </div>
          </div>
        </div>
        <button
          class="icon-btn"
          data-glass-toggle
          type="button"
          aria-pressed="true"
          aria-label="Turn the glass material off"
          title="Glass"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="4"></rect>
            <path d="M8 13.5 13.5 8M10.5 16 16 10.5" stroke-linecap="round"></path>
          </svg>
        </button>
        <button class="icon-btn" data-theme-toggle type="button" aria-pressed="false" aria-label="Switch to light theme">
          {/* The icon names where the button goes: the sun on a dark page, the moon on a light one. */}
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"></circle>
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5"></path>
          </svg>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M20 14.2A8 8 0 1 1 9.8 4a6.3 6.3 0 0 0 10.2 10.2Z" stroke-linejoin="round"></path>
          </svg>
        </button>
        <a class="icon-btn" href={`${base}/about/`} aria-label="About this site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 11.2v5.1"></path>
            <path d="M12 7.9h.01" stroke-linecap="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { initHeaderSearch } from '../lib/client/header-search.ts';
  initHeaderSearch();
</script>
