---
/**
 * The drink page — the canonical template every other page type extends.
 *
 * Structure follows the specification's own order: hero, then a two-column
 * body whose left column is one continuous stack of Serving, Drink Spec,
 * Ingredients and Glass, and whose right column is the method and then the
 * collapsed Keeping section.
 *
 * The version strip sits above the body grid because it changes both columns.
 * The Recipe / About switch sits at the head of the reading column because it
 * changes only that one — the serving controls, the spec and the checklist stay
 * put while a reader looks something up. They are deliberately different kinds
 * of control, a segmented pill and a row of underlined tabs, so that which one
 * changes what is legible at a glance.
 */
import Qty from '../live/Qty.astro';
import Measure from '../live/Measure.astro';
import { formatDuration } from '../../lib/math/units.ts';
import { formatAbv } from '../../lib/math/quantity.ts';
import { proseName } from '../../lib/render/prose.ts';
import { renderProse } from '../../lib/render/prose.ts';
import { computeBatch, linesForService } from '../../lib/math/spec.ts';
import { glassFit } from '../../lib/math/glassware.ts';
import { ALLERGEN_DISCLAIMER } from '../../lib/math/facets.ts';
import { DILUTION_DENOMINATOR_NOTE } from '../../lib/math/dilution.ts';
import { renderAbout, type AboutSource } from '../../lib/render/about.ts';
import { buildSubPayload } from '../../lib/render/substitutions.ts';
import attributions from '../../data/image-attributions.json' with { type: 'json' };
import type { ResolvedVersion } from '../../lib/content/resolve.ts';
import type { Ingredient } from '../../lib/math/types.ts';

interface ImageRecord {
  alt: string;
  renditions: Record<string, { file: string; width: number; height: number }>;
  attribution: {
    source: string;
    file?: string;
    sourceUrl?: string;
    author?: string;
    credit?: string;
    license: string;
    licenseUrl?: string;
    /** Cropping and grading make a derivative, and ShareAlike wants it named. */
    modified?: string;
  };
}

interface Props {
  slug: string;
  name: string;
  subtitle?: string;
  versions: ResolvedVersion[];
  eyebrow?: string;
  about?: { body: string; frontmatter: Record<string, unknown> } | null;
  /** Every ingredient on the site, so a substitution can name a real record. */
  ingredients: Map<string, Ingredient>;
}

const { slug, name, subtitle, versions, eyebrow, about, ingredients } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const primary = versions[0]!;
const system = 'metric' as const;

/** Editorial frontmatter the maths has no use for and the page does. */
const fm = primary.frontmatter;

/**
 * The image comes from the attribution manifest, not from the drink's own
 * frontmatter.
 *
 * The manifest already holds the alt text and the licence, written there by the
 * adoption step, so a `src` and an `alt` on the drink would be a second copy of
 * both — and the copy on the drink is the one that would go stale when an image
 * is re-adopted. It also means the only way an image reaches a page is by having
 * been adopted, which is where the licence and the credit are recorded.
 */
const media = (attributions as Record<string, ImageRecord>)[`drink:${slug}`];
const hero = media?.renditions['hero'];
const names = fm['names'] as
  | {
      alsoKnownAs?: Array<{ name: string; region?: string; note?: string }>;
      notToBeConfusedWith?: Array<{ name: string; note: string; slugRef?: string }>;
    }
  | undefined;

// Capped at four and two. The block is absent rather than placeholdered when
// there is nothing to say, which for most drinks is the case.
const alsoKnownAs = (names?.alsoKnownAs ?? []).slice(0, 4);
const confusables = (names?.notToBeConfusedWith ?? []).slice(0, 2);

const aboutRendered = about
  ? renderAbout(about.body, (about.frontmatter['sources'] as AboutSource[]) ?? [])
  : null;
const aboutSummary = about ? String(about.frontmatter['summary'] ?? '') : '';

/** Everything a version needs, computed once at build time. */
const built = versions.map((v) => {
  const spec = v.spec;
  const batch = computeBatch(spec, v.version, 12);
  const source = { lines: v.lines, steps: v.version.steps, defaultDrinks: v.version.defaultDrinks };
  const fit = v.glass ? glassFit(v.version, spec.finalVolumeMl, v.glass) : null;

  return {
    v,
    spec,
    batch,
    fit,
    // Null where nothing is substitutable, which is most drinks. The control
    // and its payload are then absent rather than empty.
    subs: buildSubPayload(v, ingredients),
    orderLines: linesForService(v.lines, batch, 'order'),
    batchLines: linesForService(v.lines, batch, 'batch'),
    steps: v.version.steps.map((step) => ({
      step,
      html: renderProse(step.prose, { source, drinks: v.version.defaultDrinks, system }),
    })),
  };
});

const one = built[0]!;

/**
 * The fact row belongs to the VERSION, not to the drink.
 *
 * Style is the version's own label by definition, and method, serving
 * temperature, strength and bitterness can all differ between two versions of
 * one drink — an egg-white sour finishes several points weaker than the plain
 * one purely because it is shaken longer. Rendering the row once from the
 * default left it stating the wrong thing the moment a reader changed tab.
 *
 * One row per version, all in the HTML, hidden by the same `data-version`
 * attribute the panels use, so the tab strip already switches them.
 */
const factRows = built.map(({ v, spec }) => ({
  id: v.version.id,
  facts: [
    ['Style', v.version.label, false],
    ['Method', v.version.method, false],
    ['Served', spec.facets.servingTemp, false],
    ['Strength', spec.facets.strength, false],
    ['Bitterness', v.version.bitterness, true],
    ...(v.frontmatter['difficulty']
      ? [['Difficulty', String(v.frontmatter['difficulty']), true] as const]
      : []),
  ] as ReadonlyArray<readonly [string, string, boolean]>,
}));
---

<div
  data-drink={primary.version.id}
  data-default-drinks={primary.version.defaultDrinks}
  data-batchable={primary.version.batchable}
  data-batch-note={primary.version.batchNote ?? ''}
  data-service="order"
>
  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={`${base}/`}>Drinks</a></li>
          <li><span aria-current="page">{name}</span></li>
        </ol>
      </nav>

      <div class={hero ? 'hero-grid' : 'hero-grid hero-grid--text-only'}>
        <div>
          {eyebrow && <div class="eyebrow">{eyebrow}</div>}
          <h1>{name}</h1>
          {subtitle && <p class="subtitle">{subtitle}</p>}

          {(alsoKnownAs.length > 0 || confusables.length > 0) && (
            <div class="naming">
              {alsoKnownAs.length > 0 && (
                <div class="naming-row">
                  <span class="naming-label">Also called</span>
                  <span>
                    {alsoKnownAs.map((n, i) => (
                      <>
                        {i > 0 && <span> · </span>}
                        <em>{n.name}</em>
                        {n.region && <span> ({n.region})</span>}
                      </>
                    ))}
                  </span>
                </div>
              )}
              {confusables.length > 0 && (
                <div class="naming-row">
                  <span class="naming-label">Not to be confused with</span>
                  <span>
                    {confusables.map((n, i) => (
                      <>
                        {i > 0 && <span> · </span>}
                        <em>{n.name}</em>
                        <span> — {n.note}</span>
                      </>
                    ))}
                  </span>
                </div>
              )}
            </div>
          )}

          {factRows.map((row, i) => (
            <div class="facts" data-version={row.id} hidden={i > 0}>
              {row.facts.map(([label, value, editorial]) => (
                <div class={editorial ? 'fact fact--editorial' : 'fact'}>
                  <span class="fact-label">{label}</span>
                  <span class="fact-value">{value}</span>
                </div>
              ))}
            </div>
          ))}
        </div>

        {hero && media && (
          <figure class="hero-figure">
            {/* Almost always the page's largest contentful paint. */}
            <img
              src={`${base}${hero.file}`}
              alt={media.alt}
              width={hero.width}
              height={hero.height}
              fetchpriority="high"
            />
            {/* The credit is an affordance rather than a caption: it belongs to
                the image and it is not what the page is about, so it sits on the
                image and opens when asked. Only the fields that exist are
                shown — never a placeholder standing in for a missing one. */}
            <div class="attribution">
              <button
                class="attribution-toggle"
                type="button"
                aria-expanded="false"
                aria-label="Image credit"
                data-attribution-toggle
              >i</button>
              <div class="attribution-popover" data-attribution-popover>
                {media.attribution.sourceUrl ? (
                  <a href={media.attribution.sourceUrl} rel="nofollow noopener">
                    {(media.attribution.file ?? media.attribution.source).replace('File:', '')}
                  </a>
                ) : (
                  <span>{media.attribution.source}</span>
                )}
                {media.attribution.author && <> — {media.attribution.author}</>}
                <br />
                {media.attribution.licenseUrl ? (
                  <a href={media.attribution.licenseUrl} rel="nofollow noopener">
                    {media.attribution.license}
                  </a>
                ) : (
                  <span>{media.attribution.license}</span>
                )}
                {media.attribution.modified && <> · {media.attribution.modified}</>}
                <p class="attribution-alt">{media.alt}</p>
              </div>
            </div>
          </figure>
        )}
      </div>
    </div>
  </section>

  {/*
    Two controls at two different scopes, and each is placed where its scope is.

    The version strip changes the whole drink — the ingredient list, the spec
    and the method all move with it — so it sits above the body grid. The
    Recipe / About switch changes only what is being read, so it sits at the
    head of the reading column: the serving controls, the spec and the checklist
    stay exactly where they are while a reader looks something up. A switch
    placed above everything would claim to change more than it does.
  */}
  <div class="wrap">
    {/* A group of mutually exclusive toggles, NOT a tab list. A tab controls
        one panel; this changes the fact row, the left column and the right
        column at once, which are three regions in three grid cells. Claiming
        the tab role would promise a screen reader a single panel relationship
        that does not exist. It is the same kind of control as Service and
        Units, and carries the same semantics. */}
    {versions.length > 1 && (
      <div class="version-strip" role="group" aria-label="Versions" data-version-strip>
        {versions.map((v, i) => (
          <button type="button" data-value={v.version.id} aria-pressed={i === 0}>
            {v.version.label}
          </button>
        ))}
      </div>
    )}

    <div class="body-grid">
      <div class="col-stack">
        <div class="left-col">
            {/* ---- serving ----
                 One card for the page. There is one drink count, one service
                 mode and one unit system, and a second copy of the controls
                 would be a second copy that nothing is listening to. What
                 varies by version is read off the version block instead. */}
            <div class="card glass">
              <h2 class="card-title">Serving</h2>

              <div class="control-row">
                <span class="control-label" id="drinks-label">Drinks</span>
                <div class="stepper">
                  <button class="step-btn" type="button" data-drinks-minus aria-label="Fewer drinks">−</button>
                  <span class="step-count" data-drink-count aria-live="polite" aria-labelledby="drinks-label">
                    {primary.version.defaultDrinks}
                  </span>
                  <button class="step-btn" type="button" data-drinks-plus aria-label="More drinks">+</button>
                </div>
              </div>

              <div class="control-row" data-service-row>
                <span class="control-label">Service</span>
                <div class="segmented" role="group" aria-label="Service mode" data-service-control>
                  <button type="button" data-value="order" aria-pressed="true">Made to order</button>
                  <button type="button" data-value="batch" aria-pressed="false">Batched ahead</button>
                </div>
              </div>
              <span class="control-reason" data-service-reason hidden></span>

              {/* A drink that never meets ice has no ice to choose. */}
              <div class="control-row" data-ice-row hidden={one.fit?.iceMl === 0}>
                <span class="control-label">Ice</span>
                <div class="segmented" role="group" aria-label="Ice style" data-ice>
                  <button type="button" data-value="cubed" aria-pressed="true">Cubed</button>
                  <button type="button" data-value="block" aria-pressed="false">Block</button>
                </div>
              </div>
              <span class="control-reason" data-ice-reason hidden={true}>
                Nothing meets ice at service in a batch, so the ice choice does not apply.
              </span>

              <div class="control-row">
                <span class="control-label">Units</span>
                <div class="segmented" role="group" aria-label="Unit system" data-units>
                  <button type="button" data-value="metric" aria-pressed="true">ml</button>
                  <button type="button" data-value="us" aria-pressed="false">oz</button>
                </div>
              </div>
              <span class="control-reason" data-units-note hidden>
                US measures are rounded to the nearest ⅛ oz, as a jigger is. Metric stays exact.
              </span>

              {/* The way into the Plan. It carries the count and the mode that
                  are set here rather than opening the planner on a blank row,
                  because the reader has already answered both questions. */}
              <button class="btn-wide" type="button" data-add-to-plan>Add to the plan</button>
              <span class="control-reason" data-plan-added hidden></span>
            </div>
        </div>

        {built.map(({ v, spec, batch, fit, orderLines, batchLines, subs }, index) => (
          <div
            data-version={v.version.id}
            data-default-drinks={v.version.defaultDrinks}
            data-batchable={v.version.batchable}
            data-batch-note={v.version.batchNote ?? ''}
            data-has-ice={fit && fit.iceMl > 0 ? '' : undefined}
            hidden={index > 0}
          >
          {/* Data, not code. `is:inline` keeps the bundler from treating a
              JSON island as a module to process. A JSX comment cannot be the
              first thing inside `cond && ( … )` — the parenthesis then opens an
              object literal — so it sits outside the guard. */}
          {subs && (
            <script type="application/json" data-sub-payload set:html={JSON.stringify(subs)} is:inline />
          )}
          <div class="left-col">
            {/* ---- the drink spec ---- */}
            <div class="card glass" data-spec-card>
              <h2 class="card-title">Drink spec — per drink</h2>

              {subs && (
                <p class="sub-banner" data-sub-banner hidden>
                  <b>Substituted</b>
                  Recomputed with <span data-sub-names></span> in place of what the recipe names.
                  <button class="link-button" type="button" data-sub-reset hidden>
                    Back to as written
                  </button>
                </p>
              )}

              <div class="spec-grid">
                <div class="spec-cell" data-spec="final-volume">
                  <span class="spec-key">Final volume</span>
                  <Measure
                    amount={spec.finalVolumeMl}
                    unit="ml"
                    system={system}
                    estimated={spec.finalVolumeEstimated}
                    title={v.brew
                      ? 'What reaches the cup, after the bed and the filter hold the rest back.'
                      : spec.dilution.note}
                  />
                </div>

                {spec.panels.alcohol && (
                  <div class="spec-cell spec-cell--alcohol" data-spec="abv">
                    <span class="spec-key">Strength</span>
                    <span class="spec-val">
                      <span
                        class={spec.alcohol.abvEstimated ? 'est' : ''}
                        data-abv-figure
                        title={DILUTION_DENOMINATOR_NOTE}
                      >
                        {spec.alcohol.abvEstimated && '~'}{spec.alcohol.finalAbvPercent.toFixed(1)}
                      </span><small>% ABV</small>
                    </span>
                  </div>
                )}

                {spec.panels.alcohol && (
                  <div class="spec-cell spec-cell--alcohol" data-spec="pure-alcohol">
                    <span class="spec-key">Pure alcohol</span>
                    <Measure amount={spec.alcohol.pureAlcoholG} unit="g" system={system} />
                  </div>
                )}

                {spec.panels.alcohol && (
                  <div class="spec-cell" data-spec="standard-drinks">
                    <span class="spec-key">Std. drinks</span>
                    <span class="spec-val">
                      <span data-std-us>{spec.alcohol.standardDrinks[0]?.drinks.toFixed(1)}</span>
                      <small>
                        US · <span data-std-uk>{spec.alcohol.standardDrinks[1]?.drinks.toFixed(1)}</span> UK
                      </small>
                    </span>
                  </div>
                )}

                <div class="spec-cell" data-spec="sugar">
                  <span class="spec-key">Sugar</span>
                  <Measure
                    amount={spec.composition.sugarG}
                    unit="g"
                    system={system}
                    suffix={`· ${Math.round(spec.sugarGPerL)} g/L`}
                    suffixAttr="data-sugar-per-litre"
                  />
                </div>

                <div class="spec-cell" data-spec="energy">
                  <span class="spec-key">Energy</span>
                  <span class="spec-val"><span data-energy-figure>{Math.round(spec.nutrition.kcal)}</span><small>kcal</small></span>
                </div>
              </div>

              <div class="balance">
                {spec.bars.map((bar) => (
                  <div class={bar.computed ? 'bar-row' : 'bar-row bar-row--editorial'} data-bar={bar.key}>
                    <span class="bar-name">{bar.label}</span>
                    <span class="bar-track">
                      <span
                        class={bar.key === 'strong' ? 'bar-fill bar-fill--alcohol' : 'bar-fill'}
                        style={`width:${bar.fillPercent.toFixed(0)}%`}
                      ></span>
                    </span>
                    <span class="bar-num">{bar.display}</span>
                  </div>
                ))}
              </div>

              {batch.available && (
                <div class="yield-line" data-when-service="batch" hidden>
                  <span class="spec-key">Batch yield</span>
                  <span class="spec-val">
                    <span data-per-drink={(batch.yieldMl / 12).toFixed(3)} data-unit="ml">
                      {Math.round(batch.yieldMl / 12 * v.version.defaultDrinks)} ml
                    </span>
                  </span>
                </div>
              )}

              <p class="disclaimer">
                Every figure above is <strong>per drink</strong> and does not move with the
                count — that is what makes the two service modes comparable. Sugar per litre,
                strength and standard drinks stay in the units their own authorities publish,
                because they are figures for comparing rather than for pouring.
                {spec.dilution.fraction > 0 && (
                  <> Dilution is modelled rather than measured, as a fraction of the poured
                  volume before any ice; dotted figures descend from that estimate.</>
                )}
              </p>

              {spec.facets.diet.allergens.length > 0 && (
                <div class="allergen-box">
                  <b>Allergens</b>
                  {spec.facets.diet.allergens.join(' · ')}
                  <p class="disclaimer">{ALLERGEN_DISCLAIMER}</p>
                </div>
              )}
            </div>

            {/* ---- extraction ----
                 Shown instead of a dilution figure, because a brewed drink
                 gains no water from ice: it loses some to the bed. */}
            {v.brew && (
              <div class="card glass">
                <h2 class="card-title">Extraction</h2>

                <div class="spec-grid">
                  <div class="spec-cell">
                    <span class="spec-key">Ratio</span>
                    <span class="spec-val">{v.brew.ratioDisplay}<small>water : coffee</small></span>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-key">Water</span>
                    <span class="spec-val">
                      {Math.round(v.brew.waterTempC)}<small>°C · {formatDuration(v.brew.contactSec)}</small>
                    </span>
                  </div>
                  <div class="spec-cell">
                    <span class="spec-key">Retention</span>
                    <Measure
                      amount={v.brew.retentionMl}
                      unit="ml"
                      system={system}
                      suffix="held back"
                    />
                  </div>
                  {v.version.brew?.grind && (
                    <div class="spec-cell">
                      <span class="spec-key">Grind</span>
                      <span class="spec-val spec-val--word">{v.version.brew.grind}</span>
                    </div>
                  )}
                </div>

                {v.brew.infusions.length > 0 && (
                  <ul class="infusions">
                    {v.brew.infusions.map((inf) => (
                      <li>
                        <span class="control-label">Infusion {inf.n}</span>
                        <span class="value">{formatDuration(inf.contactSec)}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {v.brew.standard && (
                  <>
                    <div class="control-row">
                      <span class="control-label">{v.brew.standard.label}</span>
                      <span class="value">{v.brew.standard.ratioDisplay}</span>
                    </div>
                    <p class="disclaimer">
                      This brew works out at {v.brew.standard.gPerLitre.toFixed(1)} g of coffee
                      per litre of water, against the {v.brew.standard.gPerLitreRange[0].toFixed(1)}
                      {' '}to {v.brew.standard.gPerLitreRange[1].toFixed(1)} g/L the standard allows —
                      {v.brew.standard.direction === 'within'
                        ? ' inside it.'
                        : v.brew.standard.direction === 'strong'
                          ? ' stronger than it.'
                          : ' weaker than it.'}
                      {' '}The comparison is made in grams per litre and not on the ratio, because a
                      ratio is the reciprocal of a strength and a symmetric band on one is an
                      asymmetric band on the other.
                      {!v.brew.standard.waterTempWithinTolerance &&
                        ' The water temperature also sits outside the standard.'}
                      {' '}Source: {v.brew.standard.source.title}, {v.brew.standard.source.publisher}.
                    </p>
                  </>
                )}

                {v.brew.extractionYieldPercent === null && (
                  <p class="disclaimer">
                    No extraction yield is shown. It needs a measured dissolved-solids figure from
                    the finished cup, nothing on a bag of coffee supplies one, and estimating it
                    from the method would be inventing the single number the calculation exists to
                    establish.
                  </p>
                )}
              </div>
            )}

            {/* ---- ingredients ---- */}
            <div class="card glass">
              <h2 class="card-title">Ingredients</h2>

              {(
                [
                  ['order', orderLines],
                  ['batch', batchLines],
                ] as const
              ).map(([mode, rows]) => (
                <ul class="ing-list" data-when-service={mode} hidden={mode === 'batch'}>
                  {rows.map((r) => (
                    <li class={r.line.computed ? 'ing-item is-computed' : 'ing-item'}>
                      <input class="tick" type="checkbox" aria-label={r.ingredient.name} />
                      <span class="swatch"></span>
                      <span class="ing-body">
                        <Qty
                          data={{
                            amount: r.line.amount,
                            unit: r.line.unit,
                            defaultDrinks: v.version.defaultDrinks,
                            name: proseName(r),
                            countUnit: r.form.countUnit,
                            estimated: r.line.computed === true,
                          }}
                          drinks={v.version.defaultDrinks}
                          system={system}
                        />
                        {r.ingredient.proprietary && <span class="brandmark">Proprietary</span>}
                        <span class="ing-meta">
                          {r.form.abvPercent > 0 && <>{formatAbv(r.form.abvPercent)}</>}
                          {r.line.note && <> · {r.line.note}</>}
                        </span>

                        {/* Collapsed and opt-in per row, never expanded by
                            default. Choosing one recomputes the spec above:
                            a substitute here has its own strength and its own
                            sugar, so the arithmetic genuinely moves, and that
                            is what makes this different from a note. */}
                        {mode === 'order' && subs?.options[r.line.id] && (
                          <span class="subs">
                            <button class="sub-toggle" type="button" data-sub-toggle aria-expanded="false">
                              {subs.options[r.line.id]!.length === 1
                                ? '1 substitution'
                                : `${subs.options[r.line.id]!.length} substitutions`}
                            </button>
                            <span class="subs-body" hidden>
                              <label class="sub-option">
                                <input
                                  type="radio"
                                  name={`sub-${v.version.id}-${r.line.id}`}
                                  value=""
                                  data-sub-choice
                                  data-line={r.line.id}
                                  checked
                                />
                                <span>As written — {r.ingredient.name}</span>
                              </label>
                              {subs.options[r.line.id]!.map((option) => (
                                <span class="sub-choice">
                                  <label class="sub-option">
                                    <input
                                      type="radio"
                                      name={`sub-${v.version.id}-${r.line.id}`}
                                      value={option.id}
                                      data-sub-choice
                                      data-line={r.line.id}
                                      data-name={option.name}
                                    />
                                    <span>
                                      {option.name}
                                      {option.ratio && option.ratio !== '1:1' && (
                                        <em class="sub-ratio">{option.ratio}</em>
                                      )}
                                    </span>
                                  </label>
                                  <span class="sub-note">{option.note}</span>
                                  {option.impact && (
                                    <span class="sub-impact">
                                      {Object.entries(option.impact)
                                        .filter(([, value]) => value)
                                        .map(([key, value]) => `${key}: ${value}`)
                                        .join(' · ')}
                                    </span>
                                  )}
                                </span>
                              ))}
                            </span>
                          </span>
                        )}
                      </span>
                    </li>
                  ))}
                </ul>
              ))}
            </div>

            {/* ---- glass / vessel ---- */}
            {fit && v.glass && (
              <div class="card glass">
                <h2 class="card-title" data-when-service="order">Glass</h2>
                <h2 class="card-title" data-when-service="batch" hidden>Vessel</h2>

                <div class="control-row" data-when-service="order">
                  <span class="control-label">{v.glass.name}</span>
                  <Measure amount={v.glass.capacityMl} unit="ml" system={system} />
                </div>
                <div class="control-row" data-when-service="batch" hidden>
                  <span class="control-label">Bottle or sealed jug</span>
                  <Measure
                    amount={Math.ceil(batch.yieldMl / 250) * 250}
                    unit="ml"
                    system={system}
                  />
                </div>

                <p class="disclaimer" data-when-service="order">
                  {fit.iceMl > 0 ? (
                    <>
                      {Math.round(fit.liquidMl)} ml of liquid plus {fit.iceMl} ml of {fit.iceStyle}
                      {' '}ice occupies about {Math.round(fit.neededMl)} ml, inside the
                      {' '}{v.glass.capacityMl} ml the glass holds.
                    </>
                  ) : (
                    <>
                      {Math.round(fit.liquidMl)} ml of liquid, served without ice, inside the
                      {' '}{v.glass.capacityMl} ml the glass holds.
                    </>
                  )} The build fails if a recipe ever exceeds its stated vessel.
                </p>
                <p class="disclaimer" data-when-service="batch" hidden>
                  A batch needs a vessel that closes and fits a fridge shelf.
                </p>
              </div>
            )}
          </div>
          </div>
        ))}
      </div>

      <div class="col-stack">
        {/* This one genuinely is a tab list: two controls, one panel each, and
            the panels are siblings of the strip. So it carries the whole
            pattern — aria-controls, tabpanel roles, and a roving tabindex so
            Tab enters the strip once and the arrows move within it. */}
        <div class="panel-switch" role="tablist" aria-label="Recipe or About" data-panel-switch>
          <button type="button" role="tab" id="tab-recipe" aria-controls="panel-recipe" data-value="recipe" aria-selected="true" tabindex="0">Recipe</button>
          <button type="button" role="tab" id="tab-about" aria-controls="panel-about" data-value="about" aria-selected="false" tabindex="-1">About</button>
        </div>

        {/* Both panels ship in the built HTML; the switch is client-side state. */}
        <div data-panel="recipe" id="panel-recipe" role="tabpanel" aria-labelledby="tab-recipe" tabindex="0">
        {built.map(({ v, batch, steps }, index) => (
          <div data-version={v.version.id} hidden={index > 0}>
          <div class="right-col">
            <div class="section-head">
              <h2>Method</h2>
              <span class="aside">
                {v.version.steps.length} steps · {formatDuration(v.timing.totalSec)}
              </span>
            </div>

            <ol class="steps">
              {steps.map(({ step, html }) => (
                <li class="step">
                  <button
                    class="step-mark"
                    type="button"
                    data-step-mark
                    aria-pressed="false"
                    aria-label="Mark this step done"
                  ></button>
                  <div>
                    <div class="step-meta">
                      {step.phase} · {formatDuration(step.durationSec)}
                    </div>
                    <p class="step-body" set:html={html} />
                    {/* A technique note explains one step and belongs beside it. */}
                    {v.notes
                      .filter((n) => n.kind === 'technique' && n.stepRef === step.id)
                      .map((n) => <p class="callout" set:html={n.html} />)}
                  </div>
                </li>
              ))}
            </ol>

            {v.notes
              .filter((n) => n.kind === 'technique' && !n.stepRef)
              .map((n) => <p class="callout" set:html={n.html} />)}

            {v.notes
              .filter((n) => n.kind === 'pitfall')
              .map((n) => (
                <p class="callout callout--pitfall">
                  <b>Common pitfall</b>
                  <span set:html={n.html} />
                </p>
              ))}

            {v.version.ferment?.safetyNote && (
              <p class="callout callout--safety">
                <b>Safety</b>
                {v.version.ferment.safetyNote}
              </p>
            )}

            <details class="keeping">
              <summary>Keeping and make-ahead</summary>
              <div class="keeping-body">
                {batch.available ? (
                  <p>
                    Batched ahead, this keeps sealed and cold. The water line the engine adds is
                    the dilution figure from the spec panel — it is not a rule of thumb.
                  </p>
                ) : (
                  <p>{v.version.batchNote ?? 'This drink is made to order.'}</p>
                )}
              </div>
            </details>
          </div>
          </div>
        ))}
        </div>

        {/* One About for the drink, not one per version: where a drink comes
            from does not change because its ratio does. */}
        <div class="right-col" data-panel="about" id="panel-about" role="tabpanel" aria-labelledby="tab-about" tabindex="0" hidden>
        <div class="section-head"><h2>About</h2></div>
        {aboutRendered ? (
          <>
            {aboutSummary && <p class="subtitle">{aboutSummary}</p>}
            <div class="about-body" set:html={aboutRendered.html} />

            {/* Numbered where the reader met them, so the list reads in the
                order the prose asks for it. */}
            <ol class="sources">
              {aboutRendered.cited.map(({ n, source }) => (
                <li id={`source-${source.id}`}>
                  <span class="source-n">{n}</span>
                  <span>
                    <em>{source.title}</em>
                    <span class="source-meta">
                      {source.publisher}
                      {source.year && <> · {source.year}</>}
                    </span>
                    {source.url && (
                      <a class="source-link" href={source.url} rel="nofollow noopener">
                        {new URL(source.url).hostname.replace(/^www\./, '')}
                      </a>
                    )}
                  </span>
                </li>
              ))}
            </ol>
          </>
        ) : (
          <p class="step-body">
            No sourced reference prose has been written for this drink yet. A shorter About
            section is not a failure; an invented one is.
          </p>
        )}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initDrink } from '../../lib/client/drink.ts';
  import { initLiveValues } from '../../lib/client/live-values.ts';
  import { initSubstitutions } from '../../lib/client/substitutions.ts';
  initLiveValues();
  initDrink();
  // Wires the toggles only. The engine it needs to recompute the spec arrives
  // as its own chunk on the first click, so a reader who never opens a
  // substitution never downloads it.
  initSubstitutions();
</script>
