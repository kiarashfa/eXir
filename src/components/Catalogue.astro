---
/**
 * The catalogue: a photo-forward card grid and a dense sortable table over the
 * same rows, with filtering and sorting over both.
 *
 * Both views ship in the HTML and the switch is presentational, so everything
 * is crawlable and every drink has a real `<a>` pointing at it from this page
 * whichever view a reader is in.
 *
 * **Filtering hides rows rather than rebuilding them from JSON.** A crawler
 * that has to run the filter island to find any drink at all is a crawler that
 * finds none. So every row is rendered once, carries its own facets as data
 * attributes, and the script only decides what is visible, and how much of it:
 * results are shown a page at a time, so the end of the page stays reachable.
 *
 * **Each axis is a menu, not a column of checkboxes.** An axis grows with the
 * catalogue — origins most of all — and a panel of open lists grew with it
 * until the controls were taller than the results. A menu is one button in a
 * row however many terms it holds; its list scrolls inside it, and past ten
 * terms it can be searched. Named vocabularies are alphabetical; the three
 * ordinal ones (strength, served, difficulty) keep their natural order.
 */
import type { CatalogEntry } from '../lib/content/site.ts';
import { humanise } from '../lib/catalog.ts';
import DrinkCard from './DrinkCard.astro';

interface Props {
  entries: CatalogEntry[];
}

const { entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * One token list per drink, read by one filter engine. Prefixed rather than
 * split across eight attributes, so a new axis costs a prefix and nothing else.
 */
const facetsOf = (e: CatalogEntry): string =>
  [
    ...e.category.map((v) => `cat:${v}`),
    ...e.baseSpirits.map((v) => `spirit:${v}`),
    ...e.origin.map((v) => `origin:${v}`),
    ...e.method.map((v) => `method:${v}`),
    `strength:${e.strength}`,
    `temp:${e.servingTemp}`,
    `diff:${e.difficulty.toLowerCase()}`,
    ...e.diets.map((v) => `diet:${v}`),
    ...e.allergens.map((v) => `allergen:${v}`),
  ].join(' ');

/** The vocabulary actually present, so no menu offers an empty result. */
const present = (pick: (e: CatalogEntry) => string[]): string[] =>
  [...new Set(entries.flatMap(pick))].filter(Boolean);

const alphabetical = (values: string[]) =>
  values.sort((a, b) => humanise(a).localeCompare(humanise(b)));

const inOrder = (values: string[], order: readonly string[]) =>
  values.sort((a, b) => order.indexOf(a) - order.indexOf(b));

const menus = [
  { key: 'cat', label: 'Category', values: alphabetical(present((e) => e.category)) },
  { key: 'spirit', label: 'Base spirit', values: alphabetical(present((e) => e.baseSpirits)) },
  { key: 'origin', label: 'Origin', values: alphabetical(present((e) => e.origin)) },
  { key: 'method', label: 'Method', values: alphabetical(present((e) => e.method)) },
  {
    key: 'strength',
    label: 'Strength',
    values: inOrder(present((e) => [e.strength]), ['zero-proof', 'low', 'medium', 'strong']),
  },
  {
    key: 'temp',
    label: 'Served',
    values: inOrder(present((e) => [e.servingTemp]), ['hot', 'warm', 'room', 'chilled', 'iced', 'frozen']),
  },
  {
    key: 'diff',
    label: 'Difficulty',
    values: inOrder(present((e) => [e.difficulty.toLowerCase()]), ['easy', 'medium', 'hard']),
  },
  { key: 'diet', label: 'Diet', values: alphabetical(present((e) => e.diets)) },
].filter((m) => m.values.length > 1);

const allergens = alphabetical(present((e) => e.allergens));

const ranges = [
  { key: 'abv', label: 'ABV', unit: '%' },
  { key: 'time', label: 'Total time', unit: 'min' },
  { key: 'kcal', label: 'Energy', unit: 'kcal' },
];

const sorts = [
  { value: 'title', label: 'Name' },
  { value: 'abv', label: 'Strength' },
  { value: 'time', label: 'Total time' },
  { value: 'kcal', label: 'Energy' },
  { value: 'diff', label: 'Difficulty' },
];

/** Past this many terms a list is searched, not scanned. */
const SEARCH_FROM = 10;

const rowData = (e: CatalogEntry) => ({
  'data-slug': e.slug,
  'data-facets': facetsOf(e),
  'data-title': e.title,
  'data-abv': e.abvPercent,
  'data-time': Math.round(e.totalSec / 60),
  'data-kcal': e.kcal,
  'data-diff': ['easy', 'medium', 'hard'].indexOf(e.difficulty.toLowerCase()),
});
---

<div class="wrap" data-pagefind-ignore>
  <form class="filters card glass" data-catalogue-filters>
    <div class="filter-top">
      <div class="filter-search">
        <label class="visually-hidden" for="cat-search">Find a drink</label>
        <input
          class="search-input"
          id="cat-search"
          type="search"
          placeholder="Find a drink by name"
          autocomplete="off"
          data-filter-search
        />
      </div>

      {/* First-class rather than a sub-option of Strength. A meaningful share
          of readers come for exactly this. */}
      <label class="zero-proof">
        <input type="checkbox" data-filter-zero-proof />
        <span>Zero-proof only</span>
      </label>

      <div class="filter-sort">
        <label for="cat-sort">Sort</label>
        <select id="cat-sort" data-filter-sort>
          {sorts.map((s) => <option value={s.value}>{s.label}</option>)}
        </select>
        <button class="chip" type="button" data-filter-direction aria-pressed="false">
          <span data-direction-label>A–Z</span>
        </button>
      </div>
    </div>

    <div class="filter-menus">
      {
        menus.map((menu) => (
          <details class="dd" data-dd>
            <summary class="dd-button">
              {menu.label}
              <span class="dd-count" data-dd-count hidden />
              <span class="dd-caret" aria-hidden="true">
                ▾
              </span>
            </summary>
            <div class="dd-panel" role="group" aria-label={menu.label}>
              {menu.values.length > SEARCH_FROM && (
                <input
                  class="dd-search"
                  type="search"
                  placeholder={`Find ${menu.label.toLowerCase()}`}
                  aria-label={`Find ${menu.label.toLowerCase()}`}
                  data-dd-search
                />
              )}
              <ul class="dd-list">
                {menu.values.map((value) => (
                  <li>
                    <label class="dd-option">
                      <input type="checkbox" data-filter-facet={`${menu.key}:${value}`} />
                      <span class="dd-label">{humanise(value)}</span>
                      <span class="dd-n" data-dd-n={`${menu.key}:${value}`} />
                    </label>
                  </li>
                ))}
              </ul>
              <p class="dd-none" data-dd-none hidden>
                Nothing matches.
              </p>
              <button class="dd-clear" type="button" data-dd-clear>
                Clear {menu.label.toLowerCase()}
              </button>
            </div>
          </details>
        ))
      }

      {
        allergens.length > 0 && (
          <details class="dd dd--exclude" data-dd>
            <summary class="dd-button">
              Exclude
              <span class="dd-count" data-dd-count hidden />
              <span class="dd-caret" aria-hidden="true">
                ▾
              </span>
            </summary>
            <div class="dd-panel" role="group" aria-label="Exclude allergens">
              <ul class="dd-list">
                {allergens.map((value) => (
                  <li>
                    <label class="dd-option">
                      <input type="checkbox" data-filter-exclude={`allergen:${value}`} />
                      <span class="dd-label">{humanise(value)}</span>
                      <span class="dd-n" data-dd-n={`allergen:${value}`} />
                    </label>
                  </li>
                ))}
              </ul>
              {/* The disclaimer travels with the only control it qualifies. */}
              <p class="dd-note">
                Computed from the ingredients listed on each page and nothing else. It cannot account
                for cross-contamination or the product you buy, and it is not medical advice.
              </p>
              <button class="dd-clear" type="button" data-dd-clear>
                Clear exclusions
              </button>
            </div>
          </details>
        )
      }

      <details class="dd" data-dd>
        <summary class="dd-button">
          Ranges
          <span class="dd-count" data-dd-count hidden />
          <span class="dd-caret" aria-hidden="true">
            ▾
          </span>
        </summary>
        <div class="dd-panel dd-panel--ranges" role="group" aria-label="Ranges">
          {
            ranges.map((range) => (
              <div class="filter-range">
                <span class="filter-range-label">{range.label}</span>
                <label class="visually-hidden" for={`min-${range.key}`}>
                  Minimum {range.label} in {range.unit}
                </label>
                <input
                  class="range-input"
                  id={`min-${range.key}`}
                  type="number"
                  inputmode="numeric"
                  placeholder="min"
                  data-filter-min={range.key}
                />
                <span aria-hidden="true">to</span>
                <label class="visually-hidden" for={`max-${range.key}`}>
                  Maximum {range.label} in {range.unit}
                </label>
                <input
                  class="range-input"
                  id={`max-${range.key}`}
                  type="number"
                  inputmode="numeric"
                  placeholder="max"
                  data-filter-max={range.key}
                />
                <span class="filter-range-unit">{range.unit}</span>
              </div>
            ))
          }
          <button class="dd-clear" type="button" data-dd-clear>
            Clear ranges
          </button>
        </div>
      </details>
    </div>
  </form>

  {/* What is filtering the list right now, each chip removing its own filter. */}
  <div class="active-filters" data-active-filters hidden></div>

  <div class="view-switch" role="group" aria-label="Catalogue view">
    <div class="segmented" data-catalogue-view>
      <button type="button" data-value="cards" aria-pressed="true">Cards</button>
      <button type="button" data-value="table" aria-pressed="false">Table</button>
    </div>
    <span class="aside" data-filter-count aria-live="polite">{entries.length} drinks</span>
    <button class="link-button" type="button" data-filter-clear hidden>Clear all</button>
  </div>
</div>

<div class="wrap" data-catalogue-panel="cards" data-pagefind-ignore>
  <div class="card-grid" data-filter-list>
    {entries.map((e) => <DrinkCard entry={e} {...rowData(e)} />)}
  </div>
</div>

<div class="wrap" data-catalogue-panel="table" data-pagefind-ignore hidden>
  <div class="table-wrap">
    <table class="dense">
      {/* Diet and allergens are deliberately absent as COLUMNS: both are lists,
          so both are wide, and together they pushed the table past the page.
          Both are still filterable, from the row's own facet attribute. */}
      <thead>
        <tr>
          <th scope="col">Drink</th>
          <th scope="col">Style</th>
          <th scope="col">Category</th>
          <th scope="col">Base</th>
          <th scope="col">Origin</th>
          <th scope="col">Method</th>
          <th scope="col">Strength</th>
          <th scope="col" class="num">ABV</th>
          <th scope="col">Served</th>
          <th scope="col" class="num">Time</th>
          <th scope="col" class="num">kcal</th>
          <th scope="col">Difficulty</th>
        </tr>
      </thead>
      <tbody data-filter-list>
        {
          entries.map((e) => (
            <tr {...rowData(e)}>
              <th scope="row">
                <a href={`${base}/drinks/${e.slug}/`}>{e.title}</a>
              </th>
              <td>{e.style}</td>
              <td>{e.category.map(humanise).join(', ')}</td>
              <td>{e.baseSpirits.map(humanise).join(', ') || '·'}</td>
              <td>{e.origin.map(humanise).join(', ')}</td>
              <td>{e.method.map(humanise).join(', ')}</td>
              <td>{humanise(e.strength)}</td>
              <td class="num">{e.abvPercent > 0 ? e.abvPercent.toFixed(1) : '·'}</td>
              <td>{humanise(e.servingTemp)}</td>
              <td class="num">{e.totalTime}</td>
              <td class="num">{e.kcal}</td>
              <td>{e.difficulty}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<div class="wrap" data-pagefind-ignore>
  <p class="no-results" data-filter-empty hidden>
    Nothing matches all of those at once. Clearing one filter is usually enough.
  </p>
  <div class="catalogue-more" data-filter-more hidden>
    <button class="catalogue-more-button" type="button" data-filter-more-button>Show more</button>
    <span class="aside" data-filter-more-note></span>
  </div>
</div>
