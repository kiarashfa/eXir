---
/**
 * The catalogue: a photo-forward card grid and a dense sortable table over the
 * same rows, with filtering and sorting over both.
 *
 * Both views ship in the HTML and the switch is presentational, so everything
 * is crawlable and every drink has a real `<a>` pointing at it from the
 * homepage whichever view a reader is in.
 *
 * **Filtering hides rows rather than rebuilding them from JSON.** Rendering the
 * catalogue client-side from `catalog-index.json` would be less code and would
 * throw away the thing the static HTML exists for — a real `<a>` per drink in
 * the served markup. A crawler that has to run the filter island to find any
 * drink at all is a crawler that finds none. So every row is rendered once,
 * carries its own facets as data attributes, and the island only decides what
 * is visible.
 */
import type { CatalogEntry } from '../lib/content/site.ts';
import { humanise } from '../lib/catalog.ts';

interface Props {
  entries: CatalogEntry[];
}

const { entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * One token list per drink, read by one filter engine.
 *
 * Prefixed rather than split across eight attributes so a new axis costs a
 * prefix and nothing else, and so the client has a single string to test.
 */
const facetsOf = (e: CatalogEntry): string =>
  [
    ...e.category.map((v) => `cat:${v}`),
    ...e.baseSpirits.map((v) => `spirit:${v}`),
    ...e.origin.map((v) => `origin:${v}`),
    ...e.method.map((v) => `method:${v}`),
    `strength:${e.strength}`,
    `temp:${e.servingTemp}`,
    `diff:${e.difficulty.toLowerCase()}`,
    ...e.diets.map((v) => `diet:${v}`),
    ...e.allergens.map((v) => `allergen:${v}`),
  ].join(' ');

/** The vocabulary actually present, so no filter offers an empty result. */
const collect = (pick: (e: CatalogEntry) => string[]): string[] =>
  [...new Set(entries.flatMap(pick))].filter(Boolean).sort();

const groups = [
  { key: 'cat', label: 'Category', values: collect((e) => e.category) },
  { key: 'spirit', label: 'Base spirit', values: collect((e) => e.baseSpirits) },
  { key: 'origin', label: 'Origin', values: collect((e) => e.origin) },
  { key: 'method', label: 'Method', values: collect((e) => e.method) },
  { key: 'strength', label: 'Strength', values: collect((e) => [e.strength]) },
  { key: 'temp', label: 'Served', values: collect((e) => [e.servingTemp]) },
  { key: 'diff', label: 'Difficulty', values: collect((e) => [e.difficulty.toLowerCase()]) },
  { key: 'diet', label: 'Diet', values: collect((e) => e.diets) },
].filter((g) => g.values.length > 1);

/**
 * The five that matter here, not all fourteen.
 *
 * Ranked by how many drinks carry each, so the list is the catalogue's own
 * answer rather than a remembered one, and capped so the exclusion group stays
 * one column beside the rest. The vocabulary is fixed at fourteen and most of
 * it will never appear in a drink; a filter offering twelve options nobody can
 * use buries the two they can.
 */
const allergenCounts = new Map<string, number>();
for (const entry of entries) {
  for (const a of entry.allergens) allergenCounts.set(a, (allergenCounts.get(a) ?? 0) + 1);
}
const allergens = [...allergenCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 5)
  .map(([id]) => id);

const ranges = [
  { key: 'abv', label: 'ABV', unit: '%' },
  { key: 'time', label: 'Total time', unit: 'min' },
  { key: 'kcal', label: 'Energy', unit: 'kcal' },
];

const sorts = [
  { value: 'title', label: 'Name' },
  { value: 'abv', label: 'Strength' },
  { value: 'time', label: 'Total time' },
  { value: 'kcal', label: 'Energy' },
  { value: 'diff', label: 'Difficulty' },
];

const cap = (s: string): string => humanise(s);
---

<div class="wrap" data-pagefind-ignore>
  <form class="filters card glass" data-catalogue-filters>
    <div class="filter-top">
      <div class="filter-search">
        <label class="visually-hidden" for="cat-search">Find a drink</label>
        <input
          class="search-input"
          id="cat-search"
          type="search"
          placeholder="Find a drink by name"
          autocomplete="off"
          data-filter-search
        />
      </div>

      {/* First-class rather than a sub-option of Strength. A meaningful share
          of readers come for exactly this, and making them open a panel and
          find it inside another axis undercuts the claim that the coverage is
          first-class. */}
      <label class="zero-proof">
        <input type="checkbox" data-filter-zero-proof />
        <span>Zero-proof only</span>
      </label>

      <div class="filter-sort">
        <label for="cat-sort">Sort</label>
        <select id="cat-sort" data-filter-sort>
          {sorts.map((s) => <option value={s.value}>{s.label}</option>)}
        </select>
        <button class="chip" type="button" data-filter-direction aria-pressed="false">
          <span data-direction-label>A–Z</span>
        </button>
      </div>
    </div>

    <details class="filter-more">
      <summary>More filters</summary>
      <div class="filter-groups">
        {groups.map((group) => (
          <fieldset class="filter-group">
            <legend>{group.label}</legend>
            {group.values.map((value) => (
              <label class="filter-option">
                <input type="checkbox" data-filter-facet={`${group.key}:${value}`} />
                <span>{cap(value)}</span>
              </label>
            ))}
          </fieldset>
        ))}

        {allergens.length > 0 && (
          <fieldset class="filter-group filter-group--exclude">
            <legend>Exclude allergens</legend>
            {allergens.map((value) => (
              <label class="filter-option">
                <input type="checkbox" data-filter-exclude={`allergen:${value}`} />
                <span>{cap(value)}</span>
              </label>
            ))}
          </fieldset>
        )}

        <fieldset class="filter-group filter-group--ranges">
          <legend>Ranges</legend>
          {ranges.map((range) => (
            <div class="filter-range">
              <span class="filter-range-label">{range.label}</span>
              <label class="visually-hidden" for={`min-${range.key}`}>
                Minimum {range.label} in {range.unit}
              </label>
              <input
                class="range-input"
                id={`min-${range.key}`}
                type="number"
                inputmode="numeric"
                placeholder="min"
                data-filter-min={range.key}
              />
              <span aria-hidden="true">–</span>
              <label class="visually-hidden" for={`max-${range.key}`}>
                Maximum {range.label} in {range.unit}
              </label>
              <input
                class="range-input"
                id={`max-${range.key}`}
                type="number"
                inputmode="numeric"
                placeholder="max"
                data-filter-max={range.key}
              />
              <span class="filter-range-unit">{range.unit}</span>
            </div>
          ))}
        </fieldset>
      </div>

      {/* Under the whole grid rather than inside the allergen column: the
          disclaimer is required wherever allergens appear, and stacking it in
          one narrow track pushed the options it belongs to off the card. */}
      {allergens.length > 0 && (
        <p class="filter-note">
          Allergen flags are computed from the ingredients listed on each page and nothing else.
          They cannot account for cross-contamination or for the particular product you buy, and
          they are not medical or safety guidance.
        </p>
      )}
    </details>
  </form>

  <div class="view-switch" role="group" aria-label="Catalogue view">
    <div class="segmented" data-catalogue-view>
      <button type="button" data-value="cards" aria-pressed="true">Cards</button>
      <button type="button" data-value="table" aria-pressed="false">Table</button>
    </div>
    <span class="aside" data-filter-count aria-live="polite">{entries.length} drinks</span>
    <button class="link-button" type="button" data-filter-clear hidden>Clear filters</button>
  </div>
</div>

<div class="wrap" data-catalogue-panel="cards" data-pagefind-ignore>
  <div class="card-grid" data-filter-list>
    {entries.map((e) => (
      <a
        class="drink-card"
        href={`${base}/drinks/${e.slug}/`}
        data-slug={e.slug}
        data-facets={facetsOf(e)}
        data-title={e.title}
        data-abv={e.abvPercent}
        data-time={Math.round(e.totalSec / 60)}
        data-kcal={e.kcal}
        data-diff={['easy', 'medium', 'hard'].indexOf(e.difficulty.toLowerCase())}
      >
        <figure>
          {e.image ? (
            <img src={`${base}${e.image.card}`} alt={e.image.alt} width="800" height="1000" loading="lazy" />
          ) : (
            <span class="card-blank" aria-hidden="true">{e.title.slice(0, 1)}</span>
          )}
        </figure>
        {/* Three rows, not two: where a drink is from and what kind of drink it
            is, then its name, then what the engine computed about it. The
            eyebrow is the same pair the drink page's own hero leads with, so a
            card and the page it opens introduce the drink the same way. */}
        <div class="card-eyebrow">
          {[...e.origin, ...e.category].map(cap).join(' · ')}
        </div>
        <h2>{e.title}</h2>
        <div class="card-meta">
          <span>{e.style}</span>
          {e.abvPercent > 0 && <span class="alc">{e.abvPercent.toFixed(1)}% ABV</span>}
          {e.abvPercent === 0 && <span class="zero">Zero-proof</span>}
          <span>{e.totalTime}</span>
          <span>{e.kcal} kcal</span>
        </div>
      </a>
    ))}
  </div>
  <p class="no-results" data-filter-empty hidden>
    Nothing matches all of those at once. Clearing one filter is usually enough.
  </p>
</div>

<div class="wrap" data-catalogue-panel="table" data-pagefind-ignore hidden>
  <div class="table-wrap">
    <table class="dense">
      {/* Diet and allergens are deliberately absent as COLUMNS. Both are lists,
          so both are wide, and together they pushed the table past the page
          into a horizontal scroll on a desktop screen — which costs every
          reader something to serve the few filtering on them. Both are still
          filterable: the filters read the row's own facet attribute, not its
          cells, so nothing was lost by not printing them. */}
      <thead>
        <tr>
          <th scope="col">Drink</th>
          <th scope="col">Style</th>
          <th scope="col">Category</th>
          <th scope="col">Base</th>
          <th scope="col">Origin</th>
          <th scope="col">Method</th>
          <th scope="col">Strength</th>
          <th scope="col" class="num">ABV</th>
          <th scope="col">Served</th>
          <th scope="col" class="num">Time</th>
          <th scope="col" class="num">kcal</th>
          <th scope="col">Difficulty</th>
        </tr>
      </thead>
      <tbody data-filter-list>
        {entries.map((e) => (
          <tr
            data-slug={e.slug}
            data-facets={facetsOf(e)}
            data-title={e.title}
            data-abv={e.abvPercent}
            data-time={Math.round(e.totalSec / 60)}
            data-kcal={e.kcal}
            data-diff={['easy', 'medium', 'hard'].indexOf(e.difficulty.toLowerCase())}
          >
            <th scope="row"><a href={`${base}/drinks/${e.slug}/`}>{e.title}</a></th>
            <td>{e.style}</td>
            <td>{e.category.map(cap).join(', ')}</td>
            <td>{e.baseSpirits.map(cap).join(', ') || '—'}</td>
            <td>{e.origin.map(cap).join(', ')}</td>
            <td>{e.method.map(cap).join(', ')}</td>
            <td>{cap(e.strength)}</td>
            <td class="num">{e.abvPercent > 0 ? e.abvPercent.toFixed(1) : '—'}</td>
            <td>{cap(e.servingTemp)}</td>
            <td class="num">{e.totalTime}</td>
            <td class="num">{e.kcal}</td>
            <td>{e.difficulty}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
