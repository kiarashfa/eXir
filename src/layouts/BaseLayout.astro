---
/**
 * The document shell. Every route renders through it, so the head is stated in
 * exactly one place.
 */
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** User-state pages hold nothing crawlable and opt out of indexing. */
  noindex?: boolean;
  /** Which nav item is the current page. */
  current?: string;
  /** The ambient wash is the fallback for pages with no photography of their own. */
  ambient?: boolean;
}

const { title, description, noindex = false, current, ambient = true } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en" data-glass="on" data-base={import.meta.env.BASE_URL.replace(/\/$/, '')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    {/*
      One SVG, served as the favicon and used again beside the wordmark, so the
      mark in the tab and the mark in the header are literally the same file
      rather than two drawings that can drift. The PNG exists only for iOS,
      which wants a raster with a solid ground behind it.
    */}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#10141b" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/*
      Read the stored theme and glass choice BEFORE first paint. Without this a
      reader who chose light gets a frame of dark on every navigation, which is
      worse than not offering the choice. Deliberately inline and deliberately
      tiny.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('exir.theme.v1');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
          var g = localStorage.getItem('exir.glass.v1');
          if (g === null) {
            if (window.matchMedia('(prefers-reduced-transparency: reduce)').matches) {
              document.documentElement.dataset.glass = 'off';
            }
          } else {
            document.documentElement.dataset.glass = g;
          }
        } catch (e) {
          /* storage unavailable; the defaults in the markup stand */
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    {ambient && <div class="ambient" aria-hidden="true"></div>}

    {/*
      The displacement map for Tier 2 refraction. Pre-baked rather than
      generated, so it costs no runtime JavaScript and no resize handler.
      Chromium is the only engine that applies an SVG filter inside
      backdrop-filter; everywhere else this is inert and the Tier 1 frost is
      what shows, which loses the bend and nothing else.
    */}
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <filter id="exir-lens" x="0%" y="0%" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="7" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="3" result="soft" />
        <feDisplacementMap in="SourceGraphic" in2="soft" scale="12" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <div class="page">
      <SiteHeader current={current} />
      {/*
        A noindex page is kept out of the SEARCH index too, in the same place
        and from the same flag. Marking it per page is how one of them ends up
        indexed anyway: the user-state pages carry prose that names drinks, so
        they turn up under a drink's own name and outrank nothing useful. One
        decision, one attribute, and `check:site` asserts the pair stays
        together.
      */}
      <main id="main" {...(noindex ? { 'data-pagefind-ignore': '' } : {})}>
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      import { initChrome } from '../lib/client/chrome.ts';
      import { initSearch } from '../lib/client/search.ts';
      import { initUnits } from '../lib/client/units.ts';
      // Units first: the drink page's own script subscribes to the same atom and
      // presses whichever button matches whatever this restores.
      initUnits();
      initChrome();
      initSearch();
    </script>
  </body>
</html>
