---
/**
 * A family page: the authored explanation of a shape, and the computed list of
 * the drinks that share it, grouped by what each is within the family.
 *
 * The member list is computed from `family` references on the drinks
 * themselves, never maintained here — a family that had to be told about its
 * own members would go stale the first time one was added.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiveValues from '../../components/live/LiveValues.astro';
import Qty from '../../components/live/Qty.astro';
import { defaultVersion, published, site } from '../../lib/content/site.ts';
import type { BaseUnit, CountUnit } from '../../lib/math/types.ts';

/**
 * A slot in the parametric formula.
 *
 * Authored as a real measure in ml or g rather than as a ratio number, so it
 * renders through the same `<Qty>` machinery a recipe does and answers the unit
 * toggle: `60 ml : 22.5 ml : 22.5 ml` in metric is `2 : ¾ : ¾ oz` in US, which
 * is how the field itself writes it.
 */
interface FormulaSlot {
  id: string;
  label: string;
  amount: number;
  unit: BaseUnit;
  /** Where the slot is counted rather than poured — bitters, in dashes. */
  countUnit?: CountUnit;
  role: string;
}

const ROLE_ORDER = ['origin', 'canonical', 'descendant', 'riff'] as const;
const ROLE_LABEL: Record<string, string> = {
  origin: 'The origin',
  canonical: 'Canonical members',
  descendant: 'Descended from another member',
  riff: 'Riffs',
  '': 'Members',
};

export async function getStaticPaths() {
  const resolved = await site();

  return [...resolved.families.values()].map((family) => {
    const members = published(resolved)
      .map((drink) => ({ drink, v: defaultVersion(drink) }))
      .filter(({ v }) => v.frontmatter['family'] === family.id)
      .map(({ drink, v }) => ({
        slug: drink.slug,
        name: drink.name,
        role: String(v.frontmatter['familyRole'] ?? ''),
        derivedFrom: (v.frontmatter['derivedFrom'] as string | undefined) ?? null,
        abv: v.spec.alcohol.finalAbvPercent,
        method: v.version.method,
      }));

    return { params: { slug: family.id }, props: { family, members } };
  });
}

const { family, members } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const summary = String(family.frontmatter['summary'] ?? '');
const name = String(family.frontmatter['name'] ?? family.id);

const paragraphs = family.body
  .trim()
  .split(/\n\s*\n/)
  .filter(Boolean);

const formula = family.frontmatter['formula'] as
  | { slots: FormulaSlot[]; note?: string }
  | undefined;

const groups = ROLE_ORDER.map((role) => ({
  role,
  label: ROLE_LABEL[role] ?? role,
  items: members.filter((m) => m.role === role),
})).filter((g) => g.items.length > 0);

const ungrouped = members.filter((m) => !ROLE_ORDER.includes(m.role as never));
---

<BaseLayout title={`${name} — eXir`} description={summary} current="families">
  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href={`${base}/`}>Drinks</a></li>
          <li><a href={`${base}/families/`}>Families</a></li>
          <li><span aria-current="page">{name}</span></li>
        </ol>
      </nav>
      <div class="hero-grid hero-grid--text-only">
        <div>
          <div class="eyebrow">Family</div>
          <h1>{name}</h1>
          <p class="subtitle">{summary}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="body-grid">
      <div class="col-stack">
        <div class="left-col">
          {/* ---- the formula ----
               The one thing a family page exists to show. It is the same live
               quantity a recipe carries, so it converts with the reader's units
               and cannot be a hand-typed ratio that drifts from the drinks
               claiming to follow it. Nothing scales it: a formula is a shape,
               not a batch, and there is no drink count on this page. */}
          {formula ? (
            <div class="card glass">
              <h2 class="card-title">The formula</h2>

              <p class="formula-line">
                {formula.slots.map((slot, i) => (
                  <>
                    {i > 0 && <span class="formula-sep"> : </span>}
                    <Qty
                      data={{
                        amount: slot.amount,
                        unit: slot.unit,
                        defaultDrinks: 1,
                        name: '',
                        ...(slot.countUnit ? { countUnit: slot.countUnit } : {}),
                      }}
                      drinks={1}
                      system="metric"
                      showName={false}
                    />
                  </>
                ))}
              </p>

              <div class="control-row">
                <span class="control-label">Units</span>
                <div class="segmented" role="group" aria-label="Unit system" data-units>
                  <button type="button" data-value="metric" aria-pressed="true">ml</button>
                  <button type="button" data-value="us" aria-pressed="false">oz</button>
                </div>
              </div>
              <span class="control-reason" data-units-note hidden>
                US measures are rounded to the nearest ⅛ oz, as a jigger is. Metric stays exact.
              </span>

              <dl class="formula-slots">
                {formula.slots.map((slot) => (
                  <>
                    <dt>{slot.label}</dt>
                    <dd>{slot.role}</dd>
                  </>
                ))}
              </dl>

              {formula.note && <p class="disclaimer">{formula.note}</p>}
            </div>
          ) : (
            <div class="card glass">
              <h2 class="card-title">The formula</h2>
              <p class="disclaimer">
                This shape has no single numeric formula. What binds its members is a
                sequence and a set of conditions rather than a ratio of volumes, and
                stating one would be inventing the thing the page is for.
              </p>
            </div>
          )}

          <div class="card glass">
            <h2 class="card-title">Members on this site</h2>
            {[...groups, ...(ungrouped.length ? [{ role: '', label: ROLE_LABEL[''] as string, items: ungrouped }] : [])].map(
              (group) => (
                <>
                  <div class="control-row">
                    <span class="control-label">{group.label}</span>
                    <span class="value">{group.items.length}</span>
                  </div>
                  <ul class="index-list">
                    {group.items.map((m) => (
                      <li>
                        <a href={`${base}/drinks/${m.slug}/`}>
                          <span>{m.name}</span>
                          <span class="aside">
                            {m.abv > 0 ? `${m.abv.toFixed(1)}%` : m.method}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ),
            )}
            {members.length === 0 && (
              <p class="disclaimer">
                Nothing on the site declares this family yet. The page exists because the shape
                does.
              </p>
            )}
          </div>
        </div>
      </div>

      <div class="col-stack">
        <div class="right-col">
          <div class="about-body">
            {paragraphs.map((p) => <p>{p.replace(/\s*\n\s*/g, ' ')}</p>)}
          </div>

          {members.some((m) => m.derivedFrom) && (
            <>
              <div class="section-head"><h2>Descent</h2></div>
              <ul class="index-list">
                {members
                  .filter((m) => m.derivedFrom)
                  .map((m) => (
                    <li>
                      <a href={`${base}/drinks/${m.slug}/`}>
                        <span>{m.name}</span>
                        <span class="aside">from {m.derivedFrom}</span>
                      </a>
                    </li>
                  ))}
              </ul>
              <p class="disclaimer">
                Descent is recorded within a family. A resemblance that crosses one is an
                ordinary cross-link rather than a lineage, and the build enforces the
                difference.
              </p>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <LiveValues />
</BaseLayout>
