---
/**
 * A user-state page. Everything on it comes out of the reader's own browser and
 * none of it exists at build time, so it carries noindex, is excluded from the
 * sitemap, and is deliberately NOT disallowed in robots.txt — a blocked path is
 * never fetched, so the tag would never be read.
 *
 * `client:only` for the same reason: rendering an empty shelf on the server and
 * replacing it a moment later is a layout shift for markup nobody reads.
 */
import MyBar from '../components/bar/MyBar.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Bar — eXir" description="Tell eXir what is on your shelf and it will tell you what you can make." noindex current="my-bar">
  <section class="wrap page-head">
    <h1>My Bar</h1>
    <p class="lede">What you can make from what you already have, and which single bottle would unlock the most.</p>
  </section>

  <MyBar client:only="svelte" />

  <div class="wrap prose-page">
    <p>
      Nothing on this page leaves your browser. There are no accounts here and nothing to sign in
      to, which also means what you save lives in one browser on one device and the site cannot
      move it for you.
    </p>
    <p>
      Pantry staples — sugar, water, salt, a lemon — are assumed rather than matched, so they are
      not on the list above and never count against a drink. Garnishes never block a match either:
      nobody is stopped from making a Negroni by having no orange.
    </p>
  </div>
</BaseLayout>
