---
/**
 * Where the site's material comes from — the sources, not the files.
 *
 * This page used to list every photograph individually. That does not scale
 * past a few dozen: at sixteen hundred drinks it becomes a thousand-row index
 * nobody reads, whose only real job is already done better elsewhere. **Each
 * image carries its own credit** in the popover behind the "i" on the image
 * itself, beside the picture it belongs to.
 *
 * What genuinely belongs in one place is the licence and attribution owed to
 * each SOURCE as a whole. Those are conditions on the site rather than on a
 * file — and there are eleven of them, which is a table's worth of information
 * rather than an essay's. So it is built as cards: a name, what it gives us,
 * and the terms, in the same three-part shape every time, so a reader comparing
 * two sources compares the same fields rather than two paragraphs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import attributions from '../data/image-attributions.json' with { type: 'json' };
import standards from '../data/service-standards.json' with { type: 'json' };
import dailyValues from '../data/daily-values.json' with { type: 'json' };
import dilution from '../data/dilution-classes.json' with { type: 'json' };
import brewing from '../data/brewing-standards.json' with { type: 'json' };
import standardDrinks from '../data/standard-drinks.json' with { type: 'json' };

interface Entry {
  attribution: Record<string, string>;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** Counted from the manifest, so the figure cannot drift from what is adopted. */
const records = Object.values(attributions as Record<string, Entry>);
const byLicence = new Map<string, number>();
for (const record of records) {
  const licence = record.attribution['license'] ?? 'not recorded';
  byLicence.set(licence, (byLicence.get(licence) ?? 0) + 1);
}
const licences = [...byLicence.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

interface Source {
  name: string;
  url?: string;
  /** One line. What this source gives the site. */
  gives: string;
  /** One line. What the site owes it. */
  terms: string;
  /** The shortest true label for the licence. */
  tag: string;
}

const groups: Array<{ title: string; note: string; sources: Source[] }> = [
  {
    title: 'Photography',
    note: 'Every image is credited on the image itself.',
    sources: [
      {
        name: 'Wikimedia Commons',
        url: 'https://commons.wikimedia.org/',
        gives: 'Every photograph on the site, chosen by hand and put through one treatment.',
        terms:
          'Per-file licences. Cropping and grading makes an adaptation, so a share-alike file obliges the result and the change is named in that image’s own credit.',
        tag: 'per file',
      },
      {
        name: 'Open Food Facts',
        url: 'https://world.openfoodfacts.org/',
        gives: 'Composition for branded products no dataset carries, and images where Commons has none.',
        terms: 'Database contents under the Open Database Licence: attribution and share-alike.',
        tag: 'ODbL',
      },
    ],
  },
  {
    title: 'Measured data',
    note: 'Where the numbers the site computes from come from.',
    sources: [
      {
        name: 'USDA FoodData Central',
        url: 'https://fdc.nal.usda.gov/',
        gives:
          'Spirits by proof, wine, beer, juices, dairy, sugars, syrups, brewed coffee and tea — the first place every figure is looked for.',
        terms: 'Work of the United States federal government.',
        tag: 'public domain',
      },
      {
        name: 'Producers’ published figures',
        gives:
          'Alcohol content and sugar for proprietary products, where the producer publishes them and no dataset carries the product.',
        terms:
          'Cited as published, on the ingredient’s own page. The site computes from them and never reproduces a producer’s arithmetic.',
        tag: 'cited',
      },
      {
        name: 'Wikidata',
        url: 'https://www.wikidata.org/',
        gives: 'Producer, country of origin and founding year for brands, and catalogue cross-checks.',
        terms: 'No attribution required. Given anyway.',
        tag: 'CC0',
      },
    ],
  },
  {
    title: 'Published standards',
    note: 'Documents rather than datasets — models and denominators, applied rather than reproduced.',
    sources: [
      {
        name: `${dilution.classes.stirred.source.title}`,
        gives: `${dilution.classes.stirred.source.author}’s closed-form stirred-dilution model. Every final volume and every ABV on the site descends from it.`,
        terms: 'Applied, not reproduced. The formula is used; the text is not copied.',
        tag: 'cited',
      },
      {
        name: brewing.standards['sca-golden-cup'].source.title,
        url: brewing.standards['sca-golden-cup'].source.url,
        gives: `${brewing.standards['sca-golden-cup'].gPerLitre} g of coffee per litre, ±${brewing.standards['sca-golden-cup'].tolerancePercent}% — the band a brewed drink’s own ratio is shown against.`,
        terms: `Published by the ${brewing.standards['sca-golden-cup'].source.publisher}.`,
        tag: 'cited',
      },
      {
        name: 'Standard-drink definitions',
        gives: `The two denominators on every alcoholic drink: ${standardDrinks.denominators.map((d) => `${d.label} at ${d.gramsPerDrink} g`).join(' and ')}. Both, because the authorities differ.`,
        terms: 'Public health guidance, cited per denominator.',
        tag: 'cited',
      },
      {
        name: 'FDA reference daily values',
        url: (dailyValues.source as { url?: string }).url,
        gives: 'The reference amounts any share of a daily value is stated against.',
        terms: 'Work of the United States federal government.',
        tag: 'public domain',
      },
      {
        name: 'Standards of fill',
        url: standards.bottle.defaultSource.url,
        gives: `${standards.bottle.defaultMl} ml in the EU and ${standards.bottle.byCountry['United States']} ml in the US — the bottle sizes the party planner divides by, and the only package size on the site.`,
        terms: 'Legislation and federal regulation.',
        tag: 'public domain',
      },
    ],
  },
];
---

<BaseLayout
  title="Sources and licences — eXir"
  description="Where eXir's photography, measured data and published standards come from, and the terms they carry."
>
  <section class="wrap page-head">
    <h1>Sources and licences</h1>
    <p class="lede">
      eXir computes rather than copies, but everything it computes from came from somewhere. These
      are the sources, and the terms each one carries.
    </p>
  </section>

  <div class="wrap source-lead">
    <div class="card glass note-card">
      <h2 class="card-title">Photographs are credited on the photograph</h2>
      <p>
        Every image carries an &ldquo;i&rdquo; that opens its own record — the file, the author,
        the licence, the treatment applied and the alt text — beside the picture rather than in a
        list somewhere else. This page is for the terms that apply to a whole source, which no
        single image can state on its own.
      </p>
    </div>

    <div class="card glass note-card">
      <h2 class="card-title">Images on the site</h2>
      <div class="spec-grid">
        {licences.map(([licence, count]) => (
          <div class="spec-cell">
            <span class="spec-key">{licence}</span>
            <span class="spec-val">{count}</span>
          </div>
        ))}
      </div>
      <p class="disclaimer">
        <strong>Cropping and grading makes an adaptation.</strong>
        {' '}A share-alike file is offered on the same terms and the change is named in its credit.
        Public domain and CC-BY are preferred wherever the quality is comparable.
      </p>
    </div>
  </div>

  {groups.map((group) => (
    <div class="wrap source-group">
      <div class="section-head">
        <h2>{group.title}</h2>
        <span class="aside">{group.note}</span>
      </div>
      <div class="source-grid">
        {group.sources.map((source) => (
          <article class="card glass source-card">
            <div class="source-head">
              <h3>
                {source.url ? (
                  <a href={source.url} rel="nofollow noopener">{source.name}</a>
                ) : (
                  source.name
                )}
              </h3>
              <span class="source-tag">{source.tag}</span>
            </div>
            <dl class="source-facts">
              <dt>Gives</dt>
              <dd>{source.gives}</dd>
              <dt>Terms</dt>
              <dd>{source.terms}</dd>
            </dl>
          </article>
        ))}
      </div>
    </div>
  ))}

  <div class="wrap notes">
    <div class="card glass note-card">
      <h2 class="card-title">Something wrong here</h2>
      <p>
        If a credit is wrong, or an image should not be on the site,
        <a href="mailto:kiarashfa@gmail.com">say so</a> and it will be corrected or removed.
      </p>
    </div>
    <div class="card glass note-card">
      <h2 class="card-title">Trademarks</h2>
      <p>
        Brand names are used nominatively, to identify a product. No brand endorses or is
        affiliated with this site, and none is ranked or reviewed. See
        <a href={`${base}/about/`}>About</a> for what eXir is and how the arithmetic works.
      </p>
    </div>
  </div>
</BaseLayout>
