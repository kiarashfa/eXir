---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, usedIn } from '../../lib/content/site.ts';

const resolved = await site();
const rows = [...resolved.ingredients.values()]
  .filter((i) => i.kind === 'preparation')
  .map((i) => ({ id: i.id, name: i.name, yieldMl: i.yieldMl ?? 0, uses: usedIn(resolved, i.id).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Preparations — eXir"
  description="Syrups, cordials, shrubs and tinctures: an ingredient you make, with its yield and its shelf life."
  current="preparations"
>
  <section class="wrap page-head" data-pagefind-ignore>
    <h1>Preparations</h1>
    <p class="lede">
      An ingredient you make. Each one is both at once — composition data like any other
      ingredient, and a recipe with a yield and a shelf life, so a shopping list can offer to
      expand it into what it is made of.
    </p>
  </section>

  <div class="wrap">
    <ul class="index-list" data-pagefind-ignore>
      {rows.map((r) => (
        <li>
          <a href={`${base}/preparations/${r.id}/`}>
            <span>{r.name}</span>
            <span class="aside">{r.yieldMl} ml</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
