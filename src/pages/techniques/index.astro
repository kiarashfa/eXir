---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/content/site.ts';

const resolved = await site();
const rows = [...resolved.techniques.values()]
  .map((t) => ({ id: t.id, name: String(t.frontmatter['name'] ?? t.id) }))
  .sort((a, b) => a.name.localeCompare(b.name));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Techniques — eXir"
  description="Standalone explainers: shaking, stirring, clarifying, cold brew, fermentation."
  current="techniques"
>
  <section class="wrap page-head" data-pagefind-ignore>
    <h1>Techniques</h1>
    <p class="lede">
      Standalone explainers for the methods drinks are built on. A technique that is genuinely
      notable gets a page here as well as being inlined wherever a recipe uses it.
    </p>
  </section>

  <div class="wrap">
    {rows.length ? (
      <ul class="index-list" data-pagefind-ignore>
        {rows.map((t) => (
          <li>
            <a href={`${base}/techniques/${t.id}/`}>
              <span>{t.name}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="lede">
        None written yet. Every drink page carries its own method in full, so nothing is missing
        from a recipe while this is empty.
      </p>
    )}
  </div>
</BaseLayout>
