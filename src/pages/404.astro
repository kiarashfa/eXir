---
/**
 * The 404.
 *
 * GitHub Pages serves `/404.html` for any path it cannot resolve, including
 * under a project prefix, so this needs no configuration beyond existing at the
 * root of the build.
 *
 * It carries `noindex` for the same reason the user-state pages do — a soft 404
 * indexed under its own title is worse than none — and therefore also carries
 * the `data-pagefind-ignore` the layout stamps alongside it, so the line below
 * never turns up as a search result for a real drink.
 *
 * The status is the headline and the joke is the subtitle, in that order: a
 * reader who has just landed nowhere wants to know what happened before they
 * want to be amused about it. One line of wit, then the way out.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { builtRoutes } from '../data/routes.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/**
 * Chosen at BUILD time rather than in the browser.
 *
 * A line picked on the client would need JavaScript to say anything at all, and
 * a 404 is the page most likely to be reached by something that runs none.
 * Picking here means the page is complete in its own HTML; the cost is that
 * every visit in one build sees the same line, which nobody will ever notice.
 */
const lines = [
  'The recipe called for a page. We were out.',
  'Nothing lives at this address — the bottle is either finished, never bought, or spelled differently.',
  'This one got strained off somewhere between the shaker and the glass.',
  'Diluted past the point of usefulness. There is no page here.',
];
const quip = lines[Math.floor(Math.random() * lines.length)]!;

/** The four worth offering somebody who has just landed nowhere. */
const WAYS_OUT = ['/', '/ingredients/', '/families/', '/about/'];
const routes = builtRoutes().filter((r) => WAYS_OUT.includes(r.path));
---

<BaseLayout title="Not found — eXir" description="No page lives at this address." noindex>
  <div class="wrap notfound">
    <p class="notfound-code">404</p>
    <h1>Not found</h1>
    <p class="notfound-quip">{quip}</p>

    <nav class="notfound-ways" aria-label="Ways out">
      {routes.map((route) => <a href={`${base}${route.path}`}>{route.label}</a>)}
    </nav>

    <p class="notfound-note">
      Or search — the field is in the header, and it reaches misspellings and regional names as
      well as titles, which is very likely what brought you here.
    </p>
  </div>
</BaseLayout>
