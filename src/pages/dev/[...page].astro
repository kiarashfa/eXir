---
/**
 * The rendered QA surface.
 *
 * Renders the real drink template against the engine fixtures, so the design
 * system can be seen and driven before any content exists. Phase 7 swaps the
 * fixtures for authored drinks at their real routes; this route keeps doing the
 * same job for the fixtures.
 *
 * Emits no route at all in a production build unless EXIR_DEV=1.
 */
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DrinkPage from '../../components/drink/DrinkPage.astro';
import { loadContent } from '../../lib/content/disk.ts';
import { resolveSite } from '../../lib/content/resolve.ts';

export async function getStaticPaths() {
  // Always present in the dev server, where it is the point. A production build
  // emits nothing unless it is asked to in so many words.
  if (!import.meta.env.DEV && process.env['EXIR_DEV'] !== '1') return [];

  const content = await loadContent(path.resolve('test-fixtures/engine-content'));
  const site = resolveSite(content);

  return site.drinks.map((drink) => ({
    params: { page: drink.slug },
    props: {
      slug: drink.slug,
      name: drink.name,
      versions: drink.versions,
      issues: site.issues.filter((i) => i.where.includes(drink.slug)),
    },
  }));
}

const { slug, name, versions, issues } = Astro.props;
const primary = versions[0]!;

const eyebrow = [primary.version.method, primary.spec.facets.baseSpirits[0]?.spirit]
  .filter((v) => v && v !== 'none')
  .join(' · ');
---

<BaseLayout
  title={`${name} — eXir`}
  description={`A ${primary.version.method} drink. Every figure on this page is computed.`}
  noindex
  current="drinks"
>
  <DrinkPage
    name={name}
    subtitle={`Fixture ${slug}. Every number on this page is computed from structured data.`}
    versions={versions}
    eyebrow={eyebrow}
    about={null}
  />

  {issues.length > 0 && (
    <div class="wrap">
      <div class="card glass">
        <h2 class="card-title">Resolve issues</h2>
        <ul class="keeping-body">
          {issues.map((i) => <li>{i.where} · {i.message}</li>)}
        </ul>
      </div>
    </div>
  )}
</BaseLayout>
