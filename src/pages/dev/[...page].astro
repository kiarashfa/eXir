---
/**
 * The rendered QA surface.
 *
 * Renders the real drink template against the engine fixtures — invented drinks
 * that exercise every shape the engine handles, including several no authored
 * drink covers yet. Authored drinks have their own routes; this is for seeing a
 * template change against the awkward cases rather than the tidy ones.
 *
 * Emits no route at all in a production build unless EXIR_DEV=1.
 */
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DrinkPage from '../../components/drink/DrinkPage.astro';
import { loadContent } from '../../lib/content/disk.ts';
import { resolveSite } from '../../lib/content/resolve.ts';

export async function getStaticPaths() {
  // Always present in the dev server, where it is the point. A production build
  // emits nothing unless it is asked to in so many words.
  if (!import.meta.env.DEV && process.env['EXIR_DEV'] !== '1') return [];

  const site = resolveSite(await loadContent(path.resolve('test-fixtures/engine-content')));

  return site.drinks.map((drink) => ({
    params: { page: drink.slug },
    props: {
      slug: drink.slug,
      name: drink.name,
      versions: drink.versions,
      about: drink.about,
      fixture: true,
      issues: site.issues.filter((i) => i.where.includes(drink.slug)),
    },
  }));
}

const { slug, name, versions, about, fixture, issues } = Astro.props;
const primary = versions[0]!;

const fm = primary.frontmatter;
const origin = (fm['tags'] as { origin?: string[] } | undefined)?.origin?.[0];
const category = (fm['tags'] as { category?: string[] } | undefined)?.category?.[0];

const eyebrow = [origin, category, primary.version.method]
  .filter((v) => v && v !== 'none')
  .join(' · ');

const subtitle = fixture
  ? `Fixture ${slug}. Every number on this page is computed from structured data.`
  : (fm['subtitle'] as string | undefined);
---

<BaseLayout
  title={`${name} — eXir`}
  description={
    about ? String(about.frontmatter['summary'] ?? '') : `A ${primary.version.method} drink.`
  }
  noindex
  current="drinks"
>
  <DrinkPage
    slug={slug}
    name={name}
    subtitle={subtitle}
    versions={versions}
    eyebrow={eyebrow}
    about={about}
  />

  {issues.length > 0 && (
    <div class="wrap">
      <div class="card glass">
        <h2 class="card-title">Resolve issues</h2>
        <ul class="keeping-body">
          {issues.map((i) => <li>{i.where} · {i.message}</li>)}
        </ul>
      </div>
    </div>
  )}
</BaseLayout>
